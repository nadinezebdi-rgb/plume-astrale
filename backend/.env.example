# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_key

# Astrology API
ASTROLOGY_API_USER_ID=your-user-id
ASTROLOGY_API_KEY=your-api-key
ASTROLOGY_API_ACCESS_TOKEN=your-access-token
RESEND_API_KEY=your_resend_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ASTROLOGY_API_IO_KEY=your_astrology_api_io_key_here
# LLM (OpenAI natif)
USE_V2_ENGINE=1

# Bypass paiement (SEC-004) : code réel (jamais exposé au frontend) et comptes autorisés
# en plus des admins (emails séparés par des virgules, insensible à la casse)
PROMO_BYPASS_CODE=TOUT2026
PROMO_BYPASS_ALLOWED_EMAILS=

# Origines frontend autorisées pour les redirections Stripe (en plus de CORS_ORIGINS et des domaines par défaut)
FRONTEND_URL=
# 0 = refuse les anciens téléchargements synastrie sans token (liens envoyés avant la migration)
SYNASTRIE_LEGACY_DOWNLOAD=1

# Tests d'intégration uniquement : mots de passe des comptes de test (jamais committés)
TEST_ADMIN_PASSWORD=
TEST_USER_PASSWORD=

# Nombre de proxys de confiance devant le backend (lecture de X-Forwarded-For pour la limitation de débit)
TRUSTED_PROXY_HOPS=1
