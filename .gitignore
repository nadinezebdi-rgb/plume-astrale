.idea/
.vscode/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/install-state.gz

# Testing
coverage/

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Production builds
build/
dist/

# Environment files & secrets
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*token.json*
*credentials.json*
credentials.json
.credentials
*.key
.gitconfig
.pem

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store

# Python
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# Development tools
chainlit.md
.chainlit

# Deployment / tooling
.vercel
.wrangler
.dev.vars*
!.dev.vars.example

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Library HQ + mid-res assets (regenerated on demand, kept only in preview for admin use)
backend/assets/library/**/*_1080.png
backend/assets/library/**/*_2048.png
backend/assets/library/manifest.json

# Keep env examples tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# Keep lockfile tracked
frontend/yarn.lock

# Credentials — ne jamais committer d'identifiants
memory/test_credentials.md
memory/*credentials*
memory/*secrets*